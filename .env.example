# ============================================================
# Required
# ============================================================
RECALL_API_KEY=your-recall-api-key-here
# OpenAI key for the realtime voice model the bot speaks with.
OPENAI_API_KEY=
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok.io

# ----- Dispatch auth + per-teammate attribution --------------------------------
# JARVIS_TOKENS is the per-teammate dispatch token registry. The token (NOT the
# request body) identifies the dispatching teammate (used for attribution).
# Format: comma-separated `token:teammate` pairs.
#   - A presented token must match a registry entry, else /v1/dispatch -> 401.
#   - The request body may set `soul` (a SOUL slug to load INSTEAD of the
#     teammate's own, e.g. the shared 'jarvis' team agent), but it can NEVER
#     override the teammate (anti-spoof). `persona` is derived from the SOUL.
#   - INGEST TARGET: the transcript is ingested into the brain of the SOUL that
#     SERVED the meeting (knowledge_backend.endpoint of `soul` ?? the teammate's
#     own SOUL). So a teammate running their own Delegate compounds THEIR brain;
#     running the shared 'jarvis' SOUL compounds the team brain. (Set ingest:false
#     on the shared SOUL if team meetings should not be ingested anywhere.)
JARVIS_TOKENS=tok-david:david,tok-alice:alice
# Legacy single-token mode (back-compat). When JARVIS_TOKENS is unset, a matching
# JARVIS_API_TOKEN resolves to DEFAULT_TEAMMATE. OWNER_TOKEN (below) also authenticates
# dispatch as DEFAULT_TEAMMATE. /v1/dispatch is unauthenticated (dev only, falls back to
# DEFAULT_TEAMMATE) only when JARVIS_TOKENS, JARVIS_API_TOKEN and OWNER_TOKEN are ALL unset.
JARVIS_API_TOKEN=your-secret-dispatch-token
# Shared secret authenticating the Recall webhook. When set, create-bot registers
# the webhook URL as `${PUBLIC_BASE_URL}/webhooks/recall?s=${WEBHOOK_SECRET}` and
# POST /webhooks/recall rejects (401) any request lacking the matching secret —
# this protects the spoof-proof bot.metadata attribution (teammate/soul_slug) that
# drives auto-ingest + delivery. Unset = dev-mode allow. SET THIS before exposing
# the webhook beyond a local ngrok.
WEBHOOK_SECRET=your-webhook-shared-secret
# Owner credential for the private owner panel and its API. Sent as a bearer token,
# or exchanged at POST /panel/login ({"token": ...}) for the HttpOnly `jm_owner`
# cookie. Also folded into the dispatch token registry as DEFAULT_TEAMMATE.
# REQUIRED whenever PUBLIC_BASE_URL is not localhost/127.0.0.1/::1: the service
# refuses to start on a public URL without BOTH OWNER_TOKEN and WEBHOOK_SECRET.
# Use a long random value (e.g. `openssl rand -hex 32`); never commit it.
OWNER_TOKEN=

# ============================================================
# Optional — defaults shown
# ============================================================
PORT=8790
RECALL_API_BASE=https://us-east-1.recall.ai/api/v1

JARVIS_BOT_NAME=Jarvis

# ----- Recall cost controls (web_4_core is expensive) --------------------------
# Each live bot runs the pricey web_4_core variant, so these bound spend.
# MAX_CONCURRENT_PER_TEAMMATE: a teammate at the cap gets 429 CONCURRENCY_LIMIT
# from POST /v1/dispatch (checked before any paid bot is created).
MAX_CONCURRENT_PER_TEAMMATE=2
# A background sweep auto-leaves abandoned / runaway calls:
#   idle      = no activity (transcript OR participant presence/speech) for
#               MEETING_IDLE_TIMEOUT_MS — but a call where the bot is in-call with
#               a human still present is NOT idle no matter the transcript gap
#               (presence-aware sweep), so a quiet-but-occupied meeting survives.
#   max       = total runtime exceeds MEETING_MAX_DURATION_MS (hard ceiling).
# Both are best-effort (leave never throws); the sweep runs every SWEEP_INTERVAL_MS.
#
# INVARIANT: MEETING_MAX_DURATION_MS must stay ABOVE MEETING_IDLE_TIMEOUT_MS, or
# the max-duration ceiling silently shadows the idle timeout (the bot is force-left
# at max before idle can apply). With a 2h idle timeout, keep max at 4h.
MEETING_IDLE_TIMEOUT_MS=600000      # 10 minutes
MEETING_MAX_DURATION_MS=14400000    # 4 hours (must exceed the idle timeout above)
SWEEP_INTERVAL_MS=60000             # 1 minute

# ----- Knowledge-backend resilience (optional; OBSERVE-and-report, FAIL-OPEN) ---
# The delegate soul's answers are grounded by an external knowledge backend (the
# OpenBrain kb-server, typically :7401; the companion setup runs a work-scoped second
# instance on :7402 and sets KB_BACKEND_HEALTH_URL=http://127.0.0.1:7402/healthz).
# If it is down, the bot does NOT answer from memory: /api/voice/ob-search reports
# unreachable and the bot tells the user it cannot reach the owner's notes. These two
# OPTIONAL vars make that outage noticeable and recoverable WITHOUT ever blocking a
# dispatch or crashing a meeting:
#
#   KB_BACKEND_HEALTH_URL — health endpoint for the knowledge backend. When set:
#     * scripts/join-meeting.sh runs a SOFT dispatch-time preflight (Layer 2):
#       if the backend is down it optionally starts it (KB_BACKEND_ENSURE_CMD),
#       waits ~20s, then WARNS-and-continues either way (never exits non-zero).
#     * the in-meeting cost-control sweep (Layer 3) probes it each tick and logs
#       ONE structured warning when it is down while a meeting is live. It does
#       NOT restart anything — restart authority belongs to the OS supervisor.
#     Unset (default) => both layers are complete no-ops (no behavior change).
#   KB_BACKEND_ENSURE_CMD — optional shell command Layer 2 runs (nohup/disown) to
#     start the backend when it is down. Unset => Layer 2 only warns, never starts.
KB_BACKEND_HEALTH_URL=
KB_BACKEND_ENSURE_CMD=
# Bearer token the bot presents to the knowledge backend. Unset = no Authorization header.
# Sent ONLY to URLs on the origin (scheme + host + port) of KB_BACKEND_HEALTH_URL, never to another SOUL's endpoint or the team KB; with KB_BACKEND_HEALTH_URL unset it is never sent.
KB_BACKEND_TOKEN=
# Comma-separated namespaces the bot may speak from wholesale. Default (empty) =
# no namespace is allowed wholesale.
WORK_SCOPE_NAMESPACES=
# EXTRA personal-life terms, comma-separated. They are ADDED to the built-in stems and
# never replace them: pediatric,nann,preschool,babysit,mortgage
# Put your own family names and any other business here, for example: milo,robin,sideshop
# A term written key:NAME (for example key:sidebiz) blocks documents whose entity_key
# contains NAME when guests are present, and allows them when you are alone in the call.
# A document whose entity_key or content has any term at the START of a word
# (case-insensitive; "_" and camelCase boundaries count as word starts) is never spoken,
# so "nann" catches nanny and nannies, "sideshop" catches sideshop.com and SideshopPets.
# Extra words for the speech-to-text vocabulary (product and company names), comma-separated:
# MEETING_VOCAB_TERMS=Acme,Northwind
PERSONAL_DENY_TERMS=
# Auto-start for the knowledge backend (scripts/up.sh runs it once, in the background).
# NEVER put a secret inline here: up.sh exports this file, so the child process inherits
# KB_SERVER_TOKEN and the other variables. up.sh does not echo the command.
# CONNECTOR_CMD='cd ~/your-brain && KB_SERVER_PORT=7402 KB_RETRIEVAL_SCOPE=work npm run kb-server'
# CONNECTOR_PORT=7402

# Team knowledge base retrieval (shared team knowledge for the 'ai' persona)
# If both endpoint + token are set, the hosted team knowledge base answer endpoint is used.
# Otherwise falls back to TEAM_KB_FALLBACK_URL (local team-kb-retrieval service).
TEAM_KB_ANSWER_ENDPOINT=
TEAM_KB_ANSWER_API_TOKEN=
TEAM_KB_FALLBACK_URL=http://localhost:3031

# ============================================================
# Phase 2: Azure Blob Storage — audio artifact upload
# ============================================================
# All three must be set together. If any is absent, artifact upload is skipped
# with a structured warn log (NOT_CONFIGURED) — the rest of the pipeline continues.
# The Recall signed audio URL is valid for ~5 hours; it is NEVER cached here.
# We stream-copy it immediately into Blob Storage and mint a long-lived SAS URL.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_BLOB_CONTAINER=meetings

# SAS token TTL for the minted read-only audio link. Default: 168h (7 days).
ARTIFACT_SAS_TTL_HOURS=168

# ============================================================
# Phase 3a: Anthropic — structured meeting summary
# ============================================================
# If ANTHROPIC_API_KEY is absent, summary generation is skipped (NOT_CONFIGURED).
# Email is skipped because it requires a generated summary, but enabled
# OpenBrain and Slack lanes continue with a failure stub plus the full transcript.
ANTHROPIC_API_KEY=
# Model used for the structured-output summary prompt. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# The summary is retried ONCE on this model when the first answer is a refusal
# (stop_reason "refusal") or has no structured output. Default: claude-opus-5-5
ANTHROPIC_FALLBACK_MODEL=claude-opus-5-5
# Maximum Anthropic output tokens per summary. Default: 4096.
MEETING_SUMMARY_MAX_TOKENS=4096
# Maximum transcript characters sent to Anthropic. Long meetings retain the newest
# content and receive a truncation note; OpenBrain ingest always keeps the full transcript.
MEETING_SUMMARY_INPUT_CHAR_CAP=400000

# ============================================================
# Phase 3b: Microsoft Graph — post-meeting email via service mailbox
# ============================================================
# All four (TENANT_ID, CLIENT_ID, CLIENT_SECRET, EMAIL_SENDER) must be set to
# enable live Graph sendMail. If any is absent, the email is rendered and written
# to .data/<botId>.email.json as a dry-run — never throws on NOT_CONFIGURED.
#
# IMPORTANT: The email body contains only a LINK to the SAS audio URL.
# The audio file is NEVER attached — multi-hour recordings bust the ~3MB Graph
# simple-send limit and the 35MB Gmail attachment cap.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# The UPN of the service mailbox that sendMail is sent FROM.
MEETING_EMAIL_SENDER=jarvis@yourcompany.com

# Comma-separated list of recipient email addresses used when the caller does not
# provide an explicit recipient list (e.g., when attendee derivation from calendar
# is not yet wired — Phase 4 concern). Empty = no email sent (still dry-runs if
# Graph is configured).
MEETING_EMAIL_DEFAULT_RECIPIENTS=you@yourcompany.com

# ============================================================
# Phase 4: SOUL-driven delivery — Slack + auto-ingest
# ============================================================
# Post-meeting delivery is driven by the teammate SOUL's `delivery` list
# (any of: email, ob, slack) plus its `ingest` flag. Each lane runs independently
# and best-effort — one failing never blocks the others or the pipeline.
#
# Slack lane (delivery includes `slack`): posts the structured notes via Slack
# chat.postMessage. SLACK_BOT_TOKEN is the bot xoxb token; the channel is taken
# from MEETING_SLACK_CHANNEL, falling back to the SOUL owner. Absent token =>
# the lane logs a warn and is skipped (never throws).
SLACK_BOT_TOKEN=
MEETING_SLACK_CHANNEL=

# OpenBrain auto-ingest lane (delivery includes `ob`, OR SOUL `ingest: true`):
# the meeting (title, date, BLUF, decisions, action items, transcript) is POSTed
# into the TEAMMATE'S OWN brain. knowledge_backend.endpoint is the backend's BASE URL
# (e.g. http://host:3031); the client appends /search, /document and /store
# (http://host:3031 -> http://host:3031/store), with this body:
#   { namespace: "second-brain", doc_type: "meeting-transcript",
#     entity_key: "meeting-<meetingId>", content: "<markdown>" }
# NOTE: the OB-side /store wrapper is a SEPARATE deliverable. If it is absent the
# ingest fails gracefully ({ ok:false }) and the pipeline continues. No env var
# here — the endpoint lives in each teammate's SOUL.md.
# Deadline for one OpenBrain /store request. Default: 120000ms (2 minutes).
MEETING_INGEST_TIMEOUT_MS=120000

# Default teammate used when no dispatch token resolves one (dev mode / legacy
# token). Also the SOUL slug loaded for that teammate.
DEFAULT_TEAMMATE=example
# Directory holding teammate SOUL.md files. Default: <cwd>/soul
SOUL_DIR=

# ============================================================
# Phase 5: Google Calendar Auto-Join Watcher (optional; default off)
# ============================================================
# When CALENDAR_AUTO_JOIN=true, jarvis-meeting polls Google Calendar via gws-sa,
# verifies identity against CALENDAR_PRIMARY_ACCOUNT, and dispatches Jarvis into
# confirmed video meetings (Meet, Zoom, Teams) CALENDAR_LEAD_TIME_MS before start.
# Events on CALENDAR_OPT_IN_ACCOUNTS only auto-join when tagged [jarvis] / #jarvis.
# Any event with #no-jarvis / [no-bot] or where self declined is skipped.
CALENDAR_AUTO_JOIN=false
CALENDAR_POLL_INTERVAL_MS=60000
CALENDAR_LEAD_TIME_MS=120000
CALENDAR_PRIMARY_ACCOUNT=owner@example.com
CALENDAR_OPT_IN_ACCOUNTS=owner.personal@example.com
GWS_SA_BIN=gws-sa
